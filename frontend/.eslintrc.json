{
  "env": {
    "browser": true,
    "es2022": true
  },
  "extends": ["eslint:recommended"],
  "parserOptions": {
    "ecmaVersion": 2022,
    "sourceType": "module",
    "ecmaFeatures": { "jsx": true }
  },
  "globals": {
    "React": "writable"
  },
  "rules": {
    "no-unused-vars": ["warn", {
      "argsIgnorePattern": "^_",
      "varsIgnorePattern": "^_|^[A-Z]",
      "caughtErrorsIgnorePattern": "^_"
    }],
    "no-console": "off",
    "no-empty": ["error", { "allowEmptyCatch": true }]
  }
}

# InferaCordon Environment Variables
# Copy to .env and populate before running docker compose up
# Never commit .env to version control

# ── API Security ───────────────────────────────────────────────────────────
# Tenant API key map: comma-separated key:tenant pairs
# Example: sk-acme-1234:acme_corp,sk-demo-5678:demo_tenant
TENANT_API_KEYS=sk-acme-replace-me:acme_corp,sk-demo-replace-me:demo_tenant

# ── vLLM Model Configuration ───────────────────────────────────────────────
# Primary reasoning model (4-bit quantized to fit on single A100 80GB)
DEEPSEEK_MODEL_ID=deepseek-ai/DeepSeek-R1-Distill-Qwen-7B
DEEPSEEK_QUANTIZATION=awq

# Secondary cheap model for low-complexity requests
QWEN_MODEL_ID=Qwen/Qwen2.5-3B-Instruct

# HuggingFace token for gated model downloads
HUGGINGFACE_TOKEN=hf_replace_me

# ── Semantic Cache (FAISS) ─────────────────────────────────────────────────
SEMANTIC_CACHE_SIMILARITY_THRESHOLD=0.92
SEMANTIC_CACHE_TTL_SECONDS=3600
SEMANTIC_CACHE_PERSIST_INTERVAL_SECONDS=300
CACHE_EMBEDDING_MODEL=all-MiniLM-L6-v2

# ── Async Evaluation ───────────────────────────────────────────────────────
# GPT-4o-mini LLM judge (Week 10 onwards)
OPENAI_API_KEY=sk-openai-replace-me

# ── Observability ──────────────────────────────────────────────────────────
OTEL_SERVICE_NAME=inferacordon
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4317
TRACE_RETENTION_DAYS=30

# ── Grafana ────────────────────────────────────────────────────────────────
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=inferacordon-change-me

# ── Circuit Breakers ───────────────────────────────────────────────────────
GPU_KV_CACHE_PRESSURE_THRESHOLD=0.90
LATENCY_P99_TTFT_SLO_MS=3000

# ── Admission Control ──────────────────────────────────────────────────────
MAX_CONCURRENT_REQUESTS=32
MAX_QUEUE_DEPTH=128

# ── Policy Engine ──────────────────────────────────────────────────────────
POLICY_DIR=/app/policies

# ── Guardrail Service ──────────────────────────────────────────────────────
GUARDRAIL_TIMEOUT_MS=200
GUARDRAIL_MODEL_DIR=/app/models

# ── Audit Log ──────────────────────────────────────────────────────────────
AUDIT_LOG_PATH=/app/audit/audit.jsonl
